# Use the Neon POOLED endpoint (hostname contains "-pooler") on serverless
# hosts. Each Netlify Function instance opens its own pool, so keep the limit
# small — connection_limit=10 per instance exhausts Neon under any concurrency.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=1&pool_timeout=20"

# ── Site ──
NEXT_PUBLIC_SITE_URL="https://gallery015.com"

# ── Contact Inquiry ──
CONTACT_NOTIFICATION_EMAIL="info@gallery015.com"
CONTACT_FROM_EMAIL="noreply@gallery015.com"
CONTACT_IP_HASH_SECRET="change-me-to-a-random-64-char-string"

# ── Email Delivery (SMTP) ──
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your-password"
# SMTP_SECURE="false"  # set to "true" for port 465

# ── Storage (R2 / S3-compatible) ──
OBJECT_STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET="gallery-015-media"
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_PUBLIC_BASE_URL="https://pub-<id>.r2.dev"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# ── Admin ──
# GALLERY015_ADMIN_EMAIL (required)
# GALLERY015_ADMIN_PASSWORD (required)
# GALLERY015_ADMIN_NAME (required)
# GALLERY015_ADMIN_ROLE (default: owner)
# GALLERY015_ADMIN_ORGANIZATION_ID (required)
# GALLERY015_ADMIN_SESSION_SECRET (required)

# ── Deploy (Netlify) ──
# Set every variable above in Site settings > Environment variables.
# NEXT_PUBLIC_SITE_URL must match the deployed domain or metadata and JSON-LD
# will emit the wrong canonical URLs.
GALLERY015_ADMIN_ORGANIZATION_ID="gallery-015"
