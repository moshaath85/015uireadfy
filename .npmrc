# Resolve the @react-three/drei (react 19) vs react 18.3.1 peer conflict.
# The project intentionally pins react 18; drei 10.x advertises a react 19 peer
# requirement. Netlify runs a plain `npm install`, which ERESOLVE-fails without
# this. Legacy-peer-deps mirrors how the project has always been installed
# locally (`npm install --legacy-peer-deps`).
legacy-peer-deps=true
