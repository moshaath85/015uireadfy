# =============================================================================
# GALLERY 015 — NETLIFY PRODUCTION ENVIRONMENT
# =============================================================================
# Copy this file's VARIABLES into Netlify:
#   Site settings -> Environment variables
#
# THIS FILE IS A TEMPLATE. Values marked "<REPLACE_ME>" MUST be filled with the
# real production values before / at deploy time. Do NOT commit real secrets.
#
# Real non-secret values (R2 host, bucket, admin identity) are filled from the
# working development configuration. Secrets are left as <REPLACE_ME>.
#
# The serverless build does not need these to compile (all pages are
# force-dynamic), but the deployed site WILL error on every page at request
# time if DATABASE_URL and the storage/admin values are missing.
# =============================================================================

# ── Deploy context ──
TEX7_DATABASE_ENV="production"

# ── Database (Neon PostgreSQL) ──
# Use the POOLED endpoint (hostname contains "-pooler") on serverless hosts.
# Keep connection_limit small — each Netlify Function instance opens its own
# pool, so a large limit exhausts Neon under concurrency.
DATABASE_URL="postgresql://neondb_owner:<REPLACE_ME>@ep-withered-rice-abahjvr9-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=10&pool_timeout=30"

# ── Site ──
NEXT_PUBLIC_SITE_URL="https://015g.netlify.app"

# ── Contact Inquiry ──
CONTACT_NOTIFICATION_EMAIL="info@gallery015.com"
CONTACT_FROM_EMAIL="noreply@gallery015.com"
CONTACT_IP_HASH_SECRET="<REPLACE_ME — random 64-char string>"

# ── Email Delivery (SMTP) ──
# Set if the contact form sends mail. Leave blank to disable SMTP delivery.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="<REPLACE_ME>"
# SMTP_SECURE="false"   # set to "true" for port 465

# ── Storage (Cloudflare R2 / S3-compatible) ──
OBJECT_STORAGE_ENDPOINT="https://dc5c736adfb31eff832f7c5ed18da9d0.r2.cloudflarestorage.com"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_BUCKET="gallery-015-media"
OBJECT_STORAGE_ACCESS_KEY_ID="<REPLACE_ME>"
OBJECT_STORAGE_SECRET_ACCESS_KEY="<REPLACE_ME>"
OBJECT_STORAGE_PUBLIC_BASE_URL="https://pub-87961b88feb5460199f427758d205ad9.r2.dev"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# ── Admin ──
GALLERY015_ADMIN_EMAIL="admin@gallery015.com"
GALLERY015_ADMIN_PASSWORD="<REPLACE_ME — strong password>"
GALLERY015_ADMIN_NAME="Gallery 015 Admin"
GALLERY015_ADMIN_ROLE="owner"
GALLERY015_ADMIN_ORGANIZATION_ID="gallery-015"
GALLERY015_ADMIN_SESSION_SECRET="<REPLACE_ME — random 64-char string>"
